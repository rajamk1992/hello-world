⭐ Practical Coding Answers
Debounce Implementation
JavaScript
function debounce(fn, delay) {

  let timer;

  return function (...args) {

    clearTimeout(timer);

    timer = setTimeout(() => {
      fn.apply(this, args);
    }, delay);

  };
}
Throttle Implementation
JavaScript
function throttle(fn, delay) {

  let lastCall = 0;

  return function (...args) {

    const now = Date.now();

    if (now - lastCall >= delay) {

      lastCall = now;

      fn.apply(this, args);

    }

  };
}
Flatten Array
JavaScript
function flatten(arr) {

  return arr.reduce((acc, val) => {

    return acc.concat(
      Array.isArray(val)
        ? flatten(val)
        : val
    );

  }, []);

}
Deep Clone
JavaScript
function deepClone(obj) {

  return JSON.parse(
    JSON.stringify(obj)
  );

